#!/usr/bin/env bash
# Plugin bin entry for scripts/add-tier.sh, which reads its intent on stdin. Resolved from its own location:
# bin/ is on PATH, and CLAUDE_PLUGIN_ROOT is unset in agent Bash.
set -euo pipefail
root=$(CDPATH="" cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
exec "$root/scripts/add-tier.sh" "$@"
