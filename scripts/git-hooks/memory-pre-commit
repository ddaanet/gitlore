#!/usr/bin/env bash
set -euo pipefail

# Hard gate inside the memory submodule (FR11). gitlore's own commit paths —
# the memory sync (resolve-sync-memory.sh), /gitlore:resolve, and install —
# export GITLORE_MEMORY_COMMIT before committing memory. A naked `git -C <mempath>
# commit`, a human `cd <mempath> && git commit`, or any script never do, so the
# approval gate is unreachable for them. Block those; let the blessed paths pass.
[ -n "${GITLORE_MEMORY_COMMIT:-}" ] && exit 0

# The libraries shipped beside this hook, never the ones `gitlore.hooksDir` or
# CLAUDE_PLUGIN_ROOT name: both can pin an older cache.
PLUGIN_ROOT=$(CDPATH="" cd -- "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
# shellcheck disable=SC1091
source "$PLUGIN_ROOT/scripts/lib/log.sh"

gitlore_say_for_agent_or_user \
  "gitlore: direct commits inside the memory submodule are blocked — they bypass the per-commit approval gate. To persist memory: summarize the pending changes, get explicit user approval, then run commit-memory.sh with the approved summary: from the parent repo, bash \"\$(git config gitlore.commitCommand)\" -F - with the summary on stdin, through a quoted heredoc (<<'EOF') so the shell expands nothing in it." \
  "gitlore: direct memory commits are blocked. Open this project in Claude Code and ask it to commit memory." >&2
exit 1
