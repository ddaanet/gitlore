#!/usr/bin/env bash
set -euo pipefail

# Git exports its repo-local env vars into the hook env, scoped to the PARENT
# repo. Any `git -C <submodule>` below inherits them: GIT_DIR/GIT_INDEX_FILE
# break submodule resolution ("fatal: .git/index: ... Not a directory"), and in
# a linked parent worktree GIT_COMMON_DIR/GIT_OBJECT_DIRECTORY silently redirect
# the submodule's refs and objects to the parent's store. Clear the full
# local-env-var set (githooks(5)), not a hand-picked subset.
# shellcheck disable=SC2046  # intentional word-splitting of the var-name list
unset $(git rev-parse --local-env-vars)

PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-$(git config gitlore.hooksDir)/../..}"
# shellcheck disable=SC1091
source "$PLUGIN_ROOT/scripts/lib/util.sh"
# shellcheck disable=SC1091
source "$PLUGIN_ROOT/scripts/lib/log.sh"
# shellcheck disable=SC1091
source "$PLUGIN_ROOT/scripts/lib/resolve.sh"

mempath=$(gitlore_memory_path) || mempath=""

# D11 corollary: in a session-less worktree the memory submodule worktree may not
# exist yet. Nothing to push — never block the parent push.
#
# The skip stays non-blocking, but it is not unconditionally silent. It also
# fires when memory IS initialized in this clone and its pinned commit sits ahead
# of the memory remote, and then the parent push publishes a gitlink no clone can
# resolve (NFR 2; the tier loop below refuses the same silence for the same
# reason). Warn on exactly that case, decided from the module store without a
# fetch: no module store means memory was never initialized here, so nothing
# local can be ahead; a gitlink already reachable from the memory remote's `live`
# is published and needs no warning. Every other outcome — no gitlink in HEAD, no
# remote-tracking ref, an unreadable store — warns, since the question the check
# asks cannot be answered and an unpublished gitlink is the costlier miss.
if [ -n "$mempath" ] && [ ! -e "$mempath/.git" ]; then
  # Off `--git-common-dir`, never `--git-path`: the module store is shared across
  # worktrees, but `--git-path modules/x` resolves against the *per-worktree*
  # gitdir and hands back `.git/worktrees/<wt>/modules/x`, which never exists —
  # so the check would read every linked worktree as a fresh clone and stay
  # silent in precisely the case it exists for. Relative (`.git`) in a main
  # worktree, absolute in a linked one; only used as a prefix, never cd'd into.
  modstore="$(git rev-parse --git-common-dir)/modules/$GITLORE_SUBMODULE_NAME"
  if [ -d "$modstore" ] &&
     ! git -C "$modstore" merge-base --is-ancestor \
         "$(git rev-parse "HEAD:$mempath")" refs/remotes/origin/live; then
    gitlore_say_for_agent_or_user \
      "gitlore: memory is not checked out in this worktree, so the memory push was skipped, and the memory commit this push publishes may not be on the memory remote. Run \`git submodule update --init $mempath\` here, then push again." \
      "gitlore: memory is not checked out in this worktree, so the memory push was skipped, and the memory commit this push publishes may not be on the memory remote. Run \`git submodule update --init $mempath\` here, then push again." >&2
  fi
  exit 0
fi

# No gitlore-memory submodule registered (FR12 coexistence): never block a push.
[ -n "$mempath" ] || exit 0

# Everything from here on is shared with push-memory.sh, the standalone entry
# point (D20): tiers first, then memory, with one divergence policy at each level.
gitlore_push_stores "$mempath" || exit 1
exit 0
