#!/usr/bin/env bash
set -euo pipefail

# Git exports its repo-local env vars into the hook env, scoped to the PARENT
# repo. Any `git -C <submodule> ...` below inherits them: GIT_DIR/GIT_INDEX_FILE
# break submodule resolution ("fatal: .git/index: ... Not a directory"), and in
# a linked parent worktree GIT_COMMON_DIR/GIT_OBJECT_DIRECTORY silently redirect
# the submodule's refs and objects to the parent's store. Clear the full
# local-env-var set (githooks(5)), not a hand-picked subset.
# Capture the index git means this commit to be built from, BEFORE the unset
# below discards it. Which index that is depends on how the commit was invoked:
# `.git/index` for a plain commit, `.git/index.lock` under `-a`, and a
# `.git/next-index-*.lock` temp index for a pathspec commit. Staging the gitlink
# below has to target that same index or the commit will not see it — and for
# the two lock flavors a bare `git add` does not merely miss, it dies on
# "Unable to create '.git/index.lock': File exists" and blocks the commit.
saved_index="${GIT_INDEX_FILE-}"
# Detect a replay in progress. A rebase, cherry-pick or revert re-creates
# commits that were authored earlier, and the memory submodule's worktree does
# not move when the parent's HEAD does — so syncing here would commit today's
# memory content as part of a historical commit and re-pin that commit's
# gitlink to memory's current SHA instead of the one it recorded. An `--amend`
# at a rebase stop is the sharpest version of this. Worse, a sync that trips
# the FR11 approval gate exits non-zero, which at pre-commit does not abort a
# commit — it aborts the REBASE, mid-sequence, leaving history half-replayed.
# MERGE_HEAD is deliberately absent from this list: a merge commit is authored
# now and must pin current memory, as must a plain `--amend` on the tip.
# Resolved BEFORE the unset below, for the same reason as the index: replay
# state is per-worktree, and `--git-path` reads the env git set for this repo.
replay_op=""
for marker in rebase-merge:rebase rebase-apply:rebase \
              CHERRY_PICK_HEAD:cherry-pick REVERT_HEAD:revert; do
  if [ -e "$(git rev-parse --git-path "${marker%%:*}")" ]; then
    replay_op="${marker##*:}"
    break
  fi
done
# shellcheck disable=SC2046  # intentional word-splitting of the var-name list
unset $(git rev-parse --local-env-vars)

PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-$(git config gitlore.hooksDir)/../..}"
# shellcheck disable=SC1091
source "$PLUGIN_ROOT/scripts/lib/util.sh"
# shellcheck disable=SC1091
source "$PLUGIN_ROOT/scripts/lib/log.sh"
# shellcheck disable=SC1091
source "$PLUGIN_ROOT/scripts/lib/resolve.sh"

mempath=$(gitlore_memory_path) || mempath=""

# Not a gitlore repo (submodule unregistered) → nothing to sync.
[ -z "$mempath" ] && exit 0

# D11 corollary: in a session-less worktree the memory submodule worktree may not
# exist yet. Nothing to sync — never block the parent commit.
[ ! -e "$mempath/.git" ] && exit 0

# Announce rather than skip silently: a silent no-op is indistinguishable from
# a broken hook, and a rebase the user is stuck in is exactly when they need to
# know memory has stopped syncing.
if [ -n "$replay_op" ]; then
  gitlore_say_for_agent_or_user \
    "gitlore: a $replay_op is in progress — skipping the memory sync so the replayed commit keeps the memory pointer it recorded. Do not work around this; memory syncs on the next ordinary commit." \
    "gitlore: a $replay_op is in progress — skipping the memory sync so the replayed commit keeps the memory pointer it recorded. Memory syncs on the next ordinary commit."
  exit 0
fi

gitlore_sync_memory_to_live "$mempath" || exit $?

# Record the memory commit the sync just made. The parent's index was read
# before this hook ran, so without this the commit pins the PRE-hook memory SHA:
# every parent commit would lag one memory commit behind, and a fresh clone at
# any commit would restore stale memory. A no-op when memory did not move.
if [ -n "$saved_index" ]; then
  GIT_INDEX_FILE="$saved_index" git add -- "$mempath" || {
    gitlore_say_for_agent_or_user \
      "gitlore: memory was committed but its pointer could not be staged, so this commit would record a stale memory SHA. Inspect the index and retry." \
      "gitlore: memory was committed but its pointer could not be staged, so this commit would record a stale memory SHA. Inspect the index and retry." >&2
    exit 1
  }
else
  git add -- "$mempath" || {
    # Same consequence as the branch above, and it needs saying for the same
    # reason: without a message `set -e` aborts the commit on git's bare error,
    # leaving the user to guess that the memory pointer is what failed.
    gitlore_say_for_agent_or_user \
      "gitlore: memory was committed but its pointer could not be staged, so this commit would record a stale memory SHA. Inspect the index and retry." \
      "gitlore: memory was committed but its pointer could not be staged, so this commit would record a stale memory SHA. Inspect the index and retry." >&2
    exit 1
  }
fi
exit 0
