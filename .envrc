PATH_add .gitlore/bin

# Dev tooling from uv.lock (`uv sync` once): rumdl and PyYAML, see pyproject.toml.
export VIRTUAL_ENV=$PWD/.venv
PATH_add .venv/bin

# Sibling marketplace repo; the `just release` recipe bumps gitlore's entry
# there and pushes it. A release without this bump is invisible to end-users.
export MARKETPLACE_DIR="$PWD/../claude-plugins"
export GITLORE_AUTO_CLAUDE_PLUGIN_DIR=true
