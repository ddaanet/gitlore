#!/usr/bin/env sh
# gitlore launcher shim. Injects --settings '{"autoMemoryDirectory":…}' so CC's
# native auto-memory lands in the gitlore submodule. Identical in both placements;
# see docs/references/memory-redirect.md in the gitlore repository.

# real claude = next `claude` on PATH after stripping my own dir
unset CDPATH   # else `cd` may echo the target, corrupting the capture below
self=$(cd "$(dirname "$0")" && pwd -P)
# Every entry is resolved to the same physical form as $self before the
# comparison, because a strip that matches raw spellings leaves my own
# directory on PATH and the exec below then re-enters this script with no exit.
# A `//`, a trailing `/`, a `..` and a symlinked duplicate all spell one
# directory two ways, and macOS `$TMPDIR` ends in `/`, so every path built from
# it carries the first of those. `[ -d ]` first: a PATH entry naming a
# directory that does not exist is ordinary, and `cd` would report it.
newpath=
oldifs=$IFS
IFS=:
for d in $PATH; do
  if [ -d "$d" ]; then n=$(cd "$d" && pwd -P); else n=$d; fi
  [ "$n" = "$self" ] || newpath="${newpath:+$newpath:}$d"
done
IFS=$oldifs
# Residual: a SECOND copy of this shim, in a directory of its own, is not
# something the strip can see, and exec'ing it loops forever. The installer
# places one, and no sentinel distinguishes that re-entry from an ordinary
# nested `claude` inside a session, so it is left uncovered rather than
# half-covered.
real=$(PATH="$newpath" command -v claude) || { echo "gitlore: real claude not found" >&2; exit 127; }

# already injected upstream? pass through (composability, anti-double-inject, anti-recursion)
[ -n "$GITLORE_LAUNCHED" ] && exec "$real" "$@"

# in a gitlore-enabled repo? cheap git checks first, so jq only runs for actual gitlore repos
# Redirects kept deliberately in this file: the shim wraps EVERY `claude`
# invocation, including ones outside any repo or in a non-gitlore repo. Those
# failures are the common case, each already has its answer (passthrough below),
# and their messages would print on every unrelated launch.
root=$(git rev-parse --show-toplevel 2>/dev/null)
[ -n "$root" ] || exec "$real" "$@"                               # not in a repo → passthrough
mempath=$(git config --file "$root/.gitmodules" submodule.gitlore-memory.path)
[ -n "$mempath" ] || exec "$real" "$@"                            # no gitlore submodule → passthrough
[ "$(jq -r '.gitlore.enabled // false' "$root/.claude/settings.json" 2>/dev/null)" = true ] \
  || exec "$real" "$@"                                            # submodule present but disabled → passthrough

# Containment. `mempath` comes from the checkout's own `.gitmodules`, and the
# redirect gives it the standing of a value the user typed, so it must name a
# directory inside the repo. That is a refusal rather than a miss, so it says
# why on one line and launches claude unredirected. Lexical checks first, since
# before `git submodule update --init` the directory does not exist yet: no
# absolute path, no `..` component (a component, so `my..memory` passes).
refuse() {   # refuse <reason> <claude args>…
  echo "gitlore: memory path '$mempath' in .gitmodules $1; launching claude without the memory redirect" >&2
  shift
  exec "$real" "$@"
}
case "$mempath" in /*) refuse "is absolute" "$@" ;; esac
case "/$mempath/" in */../*) refuse "has a '..' component" "$@" ;; esac
# Then the physical check, on the nearest existing directory: a symlink at the
# memory path or at any parent of it can still point out of the repo, and Claude
# Code would create a missing memory directory through it. A symlink met on the
# way up, dangling or not, is refused outright: nothing to resolve it against.
p="$root/$mempath"
while [ ! -d "$p" ]; do
  [ -L "$p" ] && refuse "crosses a symlink that names no directory" "$@"
  p=${p%/*}
done
pabs=$(cd "$p" && pwd -P) || refuse "cannot be resolved" "$@"
rootabs=$(cd "$root" && pwd -P) || refuse "cannot be resolved" "$@"
case "$pabs/" in "$rootabs"/*) ;; *) refuse "resolves outside the repo" "$@" ;; esac

json=$(jq -nc --arg p "$root/$mempath" '{autoMemoryDirectory:$p}')
export GITLORE_LAUNCHED=1
exec "$real" --settings "$json" "$@"
