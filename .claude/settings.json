{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/plugin-dev/version-guard.sh\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/plugin-dev/dogfood.sh\" pre-tool"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/plugin-dev/dogfood.sh\" session-start"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "gitlore@ddaanet": true,
    "onekeys@ddaanet": true,
    "commit-commands@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "handoff@ddaanet": true
  },
  "extraKnownMarketplaces": {
    "ddaanet": {
      "source": {
        "source": "github",
        "repo": "ddaanet/claude-plugins"
      },
      "autoUpdate": true
    }
  },
  "gitlore": {
    "enabled": true,
    "precommitCommand": ".git/gitlore-pre-commit"
  }
}
